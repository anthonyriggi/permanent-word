{
  "name": "permanent-word",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, static Scripture reader with local text integrity verification.",
  "type": "commonjs",
  "scripts": {
    "start": "python3 -m http.server 5500",
    "serve": "python3 -m http.server 5500",
    "source:download": "node scripts/download-source.js",
    "source:check": "node scripts/check-source.js",
    "source:import:john": "node scripts/import-gutenberg-john.js",
    "source:import:gospels": "node scripts/import-gutenberg-gospels.js",
    "build:data": "node scripts/build-data.js source/gospels-gutenberg.json",
    "build:john": "node scripts/build-data.js source/john-gutenberg.json",
    "build:sample": "node scripts/build-data.js source/john-sample.json",
    "check:data": "node scripts/check-data.js",
    "verify": "npm run source:check && npm run source:import:gospels && npm run build:data && npm run check:data"
  }
}