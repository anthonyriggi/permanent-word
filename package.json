{
  "name": "permanent-word",
  "version": "0.1.2",
  "private": true,
  "description": "A lightweight, static Scripture reader with local text integrity verification.",
  "type": "commonjs",
  "scripts": {
    "start": "python3 -m http.server 5500",
    "serve": "python3 -m http.server 5500",
    "source:download": "node scripts/download-source.js",
    "source:check": "node scripts/check-source.js",
    "source:import:john": "node scripts/import-gutenberg-john.js",
    "source:import:gospels": "node scripts/import-gutenberg-gospels.js",
    "source:import:nt": "node scripts/import-gutenberg-new-testament.js",
    "source:import:full": "node scripts/import-gutenberg-full-bible.js",
    "build:data": "node scripts/build-data.js source/full-bible-gutenberg.json",
    "build:nt": "node scripts/build-data.js source/new-testament-gutenberg.json",
    "build:gospels": "node scripts/build-data.js source/gospels-gutenberg.json",
    "build:john": "node scripts/build-data.js source/john-gutenberg.json",
    "build:sample": "node scripts/build-data.js source/john-sample.json",
    "build:release": "node scripts/build-release-manifest.js",
    "build:bundle": "npm run verify && node scripts/build-release-bundle.js && npm run check:bundle",
    "build:site": "npm run verify && node scripts/build-publish-folder.js",
    "build:publish": "npm run build:bundle && node scripts/build-publish-folder.js",
    "check:data": "node scripts/check-data.js",
    "check:release": "node scripts/check-release-manifest.js",
    "check:bundle": "node scripts/check-release-bundle.js",
    "verify": "npm run source:check && npm run source:import:full && npm run build:data && npm run check:data && npm run build:release && npm run check:release"
  }
}
